{
  "name": "warteamx-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, accessible Astro blog and portfolio for WarTeamX.",
  "type": "module",
  "license": "CC0-1.0",
  "homepage": "https://blog.warteamx.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warteamx/blog.git"
  },
  "bugs": {
    "url": "https://github.com/warteamx/blog/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "astro check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{astro,css,js,json,md,mdx,mjs,ts,yaml,yml}": [
      "prettier --write"
    ],
    "*.{astro,js,mjs,ts}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
