---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/utils/content';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist."
  noindex
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>The page you’re looking for has moved or never existed.</h1>
    <p class="lede">
      Try the latest writing or head back to the homepage to continue exploring the site.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={withBase('/')}>Back home</a>
      <a class="button" href={withBase('/blog/')}>Read the blog</a>
    </div>
  </section>
</BaseLayout>
