---
import { toTagSlug, withBase } from '@/utils/content';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tag-list" aria-label="Tags">
  {
    tags.map((tag) => (
      <li>
        <a href={withBase(`/tags/${toTagSlug(tag)}/`)}>{tag}</a>
      </li>
    ))
  }
</ul>
