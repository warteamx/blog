---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth <= 3);
---

{
  items.length > 0 && (
    <aside class="toc card" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>
        {items.map((heading) => (
          <li class={`toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </aside>
  )
}
