---
import { siteConfig } from '@/config/site';
import { withBase } from '@/utils/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href="https://warteamx.com" aria-label="WarTeamX main site">
        <img
          src="https://www.warteamx.com/logo.webp"
          alt="WarTeamX skull logo"
          width="64"
          height="64"
          loading="lazy"
        />
      </a>
      <p class="eyebrow">⚡ WarTeamX Software Labs</p>
      <p>
        Engineering writing focused on production-ready software, experimentation, and practical
        implementation details.
      </p>
    </div>

    <div>
      <p class="eyebrow">🗺️ Explore</p>
      <ul class="footer-links">
        <li><a href="https://warteamx.com">warteamx.com</a></li>
        <li><a href={withBase('/blog/')}>Blog</a></li>
        <li><a href={withBase('/about/')}>About</a></li>
        <li><a href={withBase('/uses/')}>Uses</a></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow">🏷️ Topics</p>
      <p>{siteConfig.featuredTopics.slice(0, 5).join(' · ')}</p>
    </div>
  </div>

  <div class="container footer-meta">
    <p>© {year} WarTeamX Software Labs. Published with Astro on GitHub Pages.</p>
    <a href={siteConfig.siteUrl}>RSS, sitemap, and metadata included</a>
  </div>
</footer>
